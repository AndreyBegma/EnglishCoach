# Copy to .env and fill in. Never commit .env.

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Host ports are non-standard on purpose (see docs/ARCHITECTURE.md).
# Inside docker compose the app service overrides these with the service hostnames.
DATABASE_URL=postgres://coach:coach@localhost:55433/coach
REDIS_URL=redis://localhost:56380
# Optional: Postgres server for DB tests (defaults to DATABASE_URL). Tests create and drop
# their own coach_test_* databases there and need CREATE DATABASE.
DATABASE_URL_TEST=
HTTP_PORT=18740

# 32 random bytes, base64. Encrypts user API keys at rest. Required.
# Generate with: openssl rand -base64 32
MASTER_KEY=

# Comma-separated Telegram user IDs that are always allowed and can /allow, /deny.
ADMIN_TELEGRAM_IDS=

# polling (default) | webhook. Webhook mode serves POST /tg/<TELEGRAM_WEBHOOK_SECRET> and
# registers <PUBLIC_URL>/tg/<secret> with Telegram.
BOT_MODE=polling
# 16-256 characters of A-Z, a-z, 0-9, _ and -. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=

# Minutes of silence after which a learning session expires and cleans up.
SESSION_TIMEOUT_MINUTES=20
# Dev only: /demo starts an echo session that proves message cleanup end to end.
ENABLE_DEMO_SESSION=false

# Server-side LLM used for the `server` provider: anthropic | openai | claude-code
SERVER_LLM_PROVIDER=
SERVER_ANTHROPIC_API_KEY=
SERVER_OPENAI_API_KEY=
# Optional, for OpenRouter or another OpenAI-compatible router.
SERVER_OPENAI_BASE_URL=
SERVER_DEFAULT_MODEL=

# Word cards enriched ahead of time with the server provider (needs SERVER_LLM_PROVIDER).
# Days of new words kept ready per learner, words per LLM call (max 20), jobs at once.
WORD_PREFETCH_DAYS=3
WORD_ENRICH_BATCH=10
WORD_ENRICH_CONCURRENCY=1
# Backfill of the rest of the owner's list: minutes between runs (0 = off), words per run per language.
WORD_BACKFILL_EVERY_MINUTES=30
WORD_BACKFILL_WORDS=20

# Where generated word pronunciations (TTS) are cached. Default: data/tts. Mount it as a volume.
TTS_CACHE_DIR=

# Path to the Claude Code CLI for the `claude-code` provider.
CLAUDE_BIN=claude

# debug | info | warn | error
LOG_LEVEL=info

# Tests only: 1 runs the live LLM smoke test (real calls, costs money) for every provider
# whose SERVER_* key is set above, or whose `claude` binary is on PATH. Leave empty in CI.
LLM_LIVE_TESTS=
# Optional model for the openai live test (e.g. an OpenRouter model id).
LLM_LIVE_OPENAI_MODEL=
